{
	# The host's nginx terminates HTTPS and proxies here; keep the client IP
	# it puts in X-Forwarded-For instead of replacing it with nginx's.
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip

	handle /api/* {
		reverse_proxy api:4000
	}
	handle /health {
		reverse_proxy api:4000
	}
	# Portal (single-page app): unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
